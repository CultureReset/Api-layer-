# === Supabase Configuration (launch gcr project) ===
# This API talks to the "launch gcr" Supabase project ONLY.
# Do not point this at the cyber check project.
GCR_SUPABASE_URL=https://xbptmkpbiqzvxptjkfoi.supabase.co
# Service role key bypasses RLS -- required since every table in launch gcr
# has RLS enabled with no policies yet. Get this from Supabase dashboard
# (Project Settings -> API -> service_role key). Never expose this key
# client-side or commit it.
GCR_SUPABASE_SERVICE_KEY=your_service_role_key_here

# === Application ===
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
